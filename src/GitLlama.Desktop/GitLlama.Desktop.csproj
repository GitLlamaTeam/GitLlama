<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>GitLlama</AssemblyName>
        <RootNamespace>GitLlama.Desktop</RootNamespace>
        <Product>GitLlama</Product>
        <Title>GitLlama</Title>
        <ApplicationIcon>Assets/gitllama.ico</ApplicationIcon>
