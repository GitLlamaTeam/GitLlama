<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitLlama.Desktop.Views.StashesView">
    <Grid Margin="12"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="10">
        <TextBlock Text="Stashes"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <TextBox Grid.Row="1"
                 Text="{Binding StashMessage}"
                 Watermark="Optional stash message" />

        <Button Grid.Row="2"
                Classes="workspace"
                Content="Stash staged changes"
                Command="{Binding SaveStagedStashCommand}" />

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Stashes}"
                 SelectedItem="{Binding SelectedStash}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Spacing="10">
            <WrapPanel ItemSpacing="8">
                <Button Classes="workspace"
                        Content="Apply (keep stash)"
                        Command="{Binding ApplySelectedStashCommand}" />

                <Button Classes="workspace"
                        Content="Pop (apply and remove)"
                        Command="{Binding PopSelectedStashCommand}" />
            </WrapPanel>

            <Expander Header="Drop selected stash">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Dropping permanently removes the saved stash without applying it." Classes="muted" />

                    <Button Classes="workspace"
                            Content="Drop selected stash"
                            Command="{Binding DropSelectedStashCommand}" />
                </StackPanel>
            </Expander>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
