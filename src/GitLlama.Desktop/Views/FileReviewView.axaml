<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GitLlama.Desktop.Controls"
             xmlns:vm="clr-namespace:GitLlama.Desktop.ViewModels"
             x:Class="GitLlama.Desktop.Views.FileReviewView">
    <Grid RowDefinitions="Auto,Auto,*" Background="#1E1F22">
        <Border Background="#25282E"
                BorderBrush="#393E47"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Classes="workspace toolbar"
                        Content="✕"
                        Command="{Binding CloseFileReviewCommand}"
                        ToolTip.Tip="Return to previous view" />

                <TextBlock Text="{Binding ReviewTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#25282E"
                BorderBrush="#393E47"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="workspace review-navigation"
                        Content="← Back"
                        Command="{Binding CloseFileReviewCommand}" />

                <Button Classes="workspace review-navigation"
                        Content="File"
                        Classes.active="{Binding IsFileMode}"
                        Command="{Binding ReviewFileCommand}" />

                <Button Classes="workspace review-navigation"
                        Content="Diff"
                        Classes.active="{Binding IsDiffReview}"
                        Command="{Binding ReviewDiffCommand}"
                        IsVisible="{Binding CanReviewDiff}" />

                <Button Classes="workspace review-navigation"
                        Content="History"
                        IsVisible="{Binding IsSingleFileReview}"
                        Classes.active="{Binding IsHistoryMode}"
                        Command="{Binding ReviewFileHistoryCommand}" />

                <Button Classes="workspace review-navigation"
                        Content="Blame"
                        IsVisible="{Binding IsSingleFileReview}"
                        Classes.active="{Binding IsBlameMode}"
                        Command="{Binding ReviewFileBlameCommand}" />

                <CheckBox Content="Staged"
                          IsChecked="{Binding ReviewStagedPatch}"
                          IsVisible="{Binding IsWorkingDiffReview}"
                          VerticalAlignment="Center" />

                <Border Width="1"
                        Height="22"
                        Background="#454B55"
                        Margin="6,0"
                        IsVisible="{Binding IsWorkingDiffReview}" />

                <Button x:Name="ApplyLineButton"
                        Classes="workspace review-action"
                        Content="{Binding ApplyLineLabel}"
                        Command="{Binding ApplySelectedLineCommand}"
                        IsVisible="{Binding IsWorkingDiffReview}" />

                <Button x:Name="ApplyHunkButton"
                        Classes="workspace review-action"
                        Classes.primary="{Binding CanApplySelectedHunk}"
                        Content="{Binding ApplyHunkLabel}"
                        Command="{Binding ApplySelectedHunkCommand}"
                        IsVisible="{Binding IsWorkingDiffReview}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" IsVisible="{Binding IsSingleFileReview}">
            <Grid IsVisible="{Binding IsHistoryMode}" ColumnDefinitions="260,6,*">
                <Border Background="#25272C" BorderBrush="#41454D" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <DockPanel Margin="10,8">
                            <Button DockPanel.Dock="Right" Classes="workspace review-navigation" Content="Refresh"
                                    Command="{Binding LoadFileHistoryCommand}" />
                            <TextBlock Text="File history" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox Grid.Row="1" x:Name="FileRevisionList" ItemsSource="{Binding FileRevisions}"
                                 SelectedItem="{Binding SelectedFileRevision}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3" Spacing="3">
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subject}" />
                                        <TextBlock Text="{Binding ShortSha}" ToolTip.Tip="{Binding Sha}"
                                                   FontFamily="Consolas, Menlo, monospace" FontSize="11" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Margin="10,8" FontSize="11" Foreground="#9CA3AF"
                                   Text="Up to 1,000 revisions · Read-only" />
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#393E47" />
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                    <Border Background="#292C32" Padding="10,6" BorderBrush="#41454D" BorderThickness="0,0,0,1">
                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                            <TextBlock Text="View" VerticalAlignment="Center" />
                            <ComboBox x:Name="FileComparisonModePicker" Width="170" ItemsSource="{Binding FileComparisonModes}"
                                      SelectedItem="{Binding FileComparisonMode}" />
                            <ComboBox x:Name="ComparisonRevisionPicker" MinWidth="200" MaxWidth="420"
                                      ItemsSource="{Binding FileRevisions}" SelectedItem="{Binding SelectedComparisonRevision}"
                                      IsVisible="{Binding IsRevisionComparison}" />
                        </WrapPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding FileHistoryFeedback}" Margin="10,6" Foreground="#B5BAC1"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,6,*">
                        <Grid Grid.ColumnSpan="{Binding HistoryPreviewColumnSpan}" RowDefinitions="Auto,*">
                            <Border Background="#292C32" Padding="10,7" BorderBrush="#41454D" BorderThickness="0,1,0,1">
                                <TextBlock Text="{Binding FileRevisionLabel}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding FileRevisionLabel}" />
                            </Border>
                            <controls:CodeView Grid.Row="1" x:Name="HistoryRevisionPreview" FilePath="{Binding FileHistoryPath}"
                                               Text="{Binding FileRevisionContent}" LineKinds="{Binding FileRevisionLineKinds}" />
                        </Grid>
                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#41454D"
                                      IsVisible="{Binding IsHistoryComparison}" />
                        <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding IsHistoryComparison}">
                            <Border Background="#292C32" Padding="10,7" BorderBrush="#41454D" BorderThickness="0,1,0,1">
                                <TextBlock Text="{Binding FileComparisonLabel}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding FileComparisonLabel}" />
                            </Border>
                            <controls:CodeView Grid.Row="1" x:Name="HistoryComparisonPreview" FilePath="{Binding FileHistoryPath}"
                                               Text="{Binding FileComparisonContent}" LineKinds="{Binding FileComparisonLineKinds}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <controls:PatchView FilePath="{Binding ReviewPath}"
                                Patch="{Binding CenterPatch}"
                                SelectedLine="{Binding SelectedPatchLine}"
                                IsVisible="{Binding IsDiffReview}" />

            <controls:CodeView FilePath="{Binding ReviewPath}"
                               Text="{Binding CenterContent}"
                               IsVisible="{Binding IsContentReview}" />
        </Grid>
        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding IsMultiFileReview}">
            <Border Background="#292C32" Padding="12,8" BorderBrush="#41454D" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding MultiFileFeedback}" Foreground="#B5BAC1" />
            </Border>
            <ScrollViewer Grid.Row="1" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding MultiFilePreviews}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MultiFilePreview">
                            <Border BorderBrush="#41454D" BorderThickness="1" Margin="0,0,0,12" CornerRadius="4">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#292C32" Padding="10,8">
                                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" />
                                    </Border>
                                    <controls:PatchView Grid.Row="1" FilePath="{Binding Path}" Patch="{Binding Content}"
                                                        Height="{Binding PreviewHeight}" IsVisible="{Binding IsDiff}" />
                                    <controls:CodeView Grid.Row="1" FilePath="{Binding Path}" Text="{Binding Content}"
                                                       Height="{Binding PreviewHeight}" IsVisible="{Binding IsFile}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
