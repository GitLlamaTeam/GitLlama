<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GitLlama.Desktop.Controls"
             xmlns:views="clr-namespace:GitLlama.Desktop.Views"
             x:Class="GitLlama.Desktop.Views.HistoryView">
    <UserControl.Styles>
        <Style Selector="GridSplitter.history-column">
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="CurrentAndNext" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="#41454D" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border Width="1" Margin="0,4" HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.history-column:pointerover, GridSplitter.history-column:focus-visible">
            <Setter Property="Background" Value="#6D8EB8" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{StaticResource SurfaceBrush}">
        <Grid Margin="8"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
            <ComboBox Width="145"
                      ItemsSource="{Binding HistoryScopes}"
                      SelectedItem="{Binding SelectedHistoryScope}" />

            <TextBox x:Name="HistoryCommitSearch"
                     Grid.Column="1"
                     Watermark="Search commits (message, author, SHA, ref…)"
                     Text="{Binding HistorySearch}" />

            <Button Classes="workspace"
                    Grid.Column="2"
                    Content="Clear"
                    Click="ClearSearch_Click"
                    IsVisible="{Binding HasHistoryFilter}" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="8,0,8,6"
                    Spacing="4">
            <Expander Header="Author and date filters">
                <WrapPanel ItemSpacing="8"
                           LineSpacing="6"
                           Margin="8">
                    <TextBox Text="{Binding HistoryAuthorFilter}"
                             Watermark="Author"
                             Width="140" />

                    <DatePicker SelectedDate="{Binding HistorySince}" ToolTip.Tip="Since date" />
                    <DatePicker SelectedDate="{Binding HistoryUntil}" ToolTip.Tip="Until date" />
                </WrapPanel>
            </Expander>

            <TextBlock Text="Filtered results · graph connections hidden"
                       IsVisible="{Binding HasHistoryFilter}"
                       Classes="muted"
                       FontSize="11" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1"
                Background="#252526">
            <Grid x:Name="HistoryColumnHeader" HorizontalAlignment="Left"
                  Width="{Binding #HistoryList.Scroll.Viewport.Width}"
                  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84*" MinWidth="48" />
                    <ColumnDefinition Width="480*" MinWidth="80" />
                    <ColumnDefinition Width="155*" MinWidth="64" />
                    <ColumnDefinition Width="112*" MinWidth="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Graph" Margin="8,7,8,7" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="Message" Margin="8,7,8,7" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="Author" Margin="8,7,8,7" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="Date" Margin="8,7,8,7" TextTrimming="CharacterEllipsis" />
                <GridSplitter x:Name="HistoryGraphDivider" Classes="history-column"
                              AutomationProperties.Name="Resize Graph and Message columns"
                              ToolTip.Tip="Resize Graph and Message columns" />
                <GridSplitter x:Name="HistoryMessageDivider" Grid.Column="1" Classes="history-column"
                              AutomationProperties.Name="Resize Message and Author columns"
                              ToolTip.Tip="Resize Message and Author columns" />
                <GridSplitter x:Name="HistoryAuthorDivider" Grid.Column="2" Classes="history-column"
                              AutomationProperties.Name="Resize Author and Date columns"
                              ToolTip.Tip="Resize Author and Date columns" />
            </Grid>
        </Border>

        <ListBox x:Name="HistoryList"
                 Grid.Row="3"
                 Classes="history"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding HistoryRows}"
                 SelectedItem="{Binding SelectedHistoryRow}"
                 ContextRequested="CommitContextRequested">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#2D2D30"
                            BorderThickness="0,0,0,1"
                            ToolTip.Tip="{Binding Sha}">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="48" Width="{Binding $parent[views:HistoryView].HistoryColumns[0].Width}" />
                                <ColumnDefinition MinWidth="80" Width="{Binding $parent[views:HistoryView].HistoryColumns[1].Width}" />
                                <ColumnDefinition MinWidth="64" Width="{Binding $parent[views:HistoryView].HistoryColumns[2].Width}" />
                                <ColumnDefinition MinWidth="64" Width="{Binding $parent[views:HistoryView].HistoryColumns[3].Width}" />
                            </Grid.ColumnDefinitions>
                            <controls:GraphCell Row="{Binding}" ClipToBounds="True" />
                            <DockPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                <ItemsControl DockPanel.Dock="Right"
                                              ItemsSource="{Binding ReferenceLabels}"
                                              Margin="6,4,0,4"
                                              MaxWidth="200">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,2"
                                                    ToolTip.Tip="{Binding ToolTip}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="120" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Subject}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                <Border DockPanel.Dock="Left"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        ClipToBounds="True"
                                        Margin="0,0,6,0"
                                        Background="{Binding AuthorAvatar.Background}"
                                        VerticalAlignment="Center">
                                    <Panel>
                                        <TextBlock Text="{Binding AuthorAvatar.Initials}"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <Image Source="{Binding AuthorAvatar.Image}" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>

                                <TextBlock Text="{Binding Author}"
                                           TextTrimming="CharacterEllipsis"
                                           Classes="muted"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Date}"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11"
                                       Classes="muted"
                                       ToolTip.Tip="{Binding FullDate}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3"
                    IsVisible="{Binding HasNoHistory}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Margin="24">
            <TextBlock Text="⑂"
                       FontSize="36"
                       Classes="muted"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding HistoryEmptyMessage}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <Button Classes="workspace"
                    Content="Open repository…"
                    Click="OpenFolder_Click"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding HasNoRepository}" />
        </StackPanel>

        <Border Grid.Row="4"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Classes="workspace"
                        Content="Load more"
                        Command="{Binding LoadMoreHistoryCommand}"
                        IsVisible="{Binding HasMoreHistory}" />

                <TextBlock Text="{Binding HistoryCaption}"
                           Classes="muted"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
