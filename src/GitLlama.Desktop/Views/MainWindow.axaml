<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:views="clr-namespace:GitLlama.Desktop.Views"
        xmlns:controls="clr-namespace:GitLlama.Desktop.Controls"
        x:Class="GitLlama.Desktop.Views.MainWindow"
        Title="GitLlama"
        Icon="/Assets/gitllama.ico"
        Width="1500"
        Height="920"
        MinWidth="1080"
        MinHeight="640"
        CanResize="True"
        SystemDecorations="None"
        Background="{StaticResource SurfaceBrush}">

    <Border x:Name="WindowFrame"
            Margin="0"
            BorderBrush="#65676F"
            BorderThickness="1"
            Background="{StaticResource SurfaceBrush}">
        <Grid>
            <DockPanel x:Name="WorkspaceContent" Background="{StaticResource SurfaceBrush}" IsEnabled="{Binding IsWorkspaceInteractive}">
                <DockPanel.KeyBindings>
                    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding CommitCommand}" />
                </DockPanel.KeyBindings>

                <StackPanel DockPanel.Dock="Top">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel Height="36"
                                   Margin="6,0"
                                   LastChildFill="False"
                                   Background="Transparent"
                                   PointerPressed="TitleBar_PointerPressed">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Margin="10,0,0,0">
                                <Button x:Name="WindowMinimizeButton"
                                        Classes="window-control"
                                        AutomationProperties.Name="Minimize window"
                                        Click="Minimize_Click"
                                        ToolTip.Tip="Minimize">
                                    <Path Width="12"
                                          Height="12"
                                          Data="M 1,6 L 11,6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.2" />
                                </Button>

                                <Button x:Name="WindowMaximizeButton"
                                        Classes="window-control"
                                        AutomationProperties.Name="Maximize or restore window"
                                        Click="Maximize_Click"
                                        ToolTip.Tip="Maximize or restore">
                                    <Path x:Name="WindowMaximizeIcon"
                                          Width="12"
                                          Height="12"
                                          Data="M 1,1 L 11,1 L 11,11 L 1,11 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.2" />
                                </Button>

                                <Button x:Name="WindowCloseButton"
                                        Classes="window-control close"
                                        AutomationProperties.Name="Close window"
                                        Click="CloseWindow_Click"
                                        ToolTip.Tip="Close">
                                    <Path Width="12"
                                          Height="12"
                                          Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.2" />
                                </Button>
                            </StackPanel>

                            <controls:LlamaIcon DockPanel.Dock="Left"
                                                Width="25"
                                                Height="25"
                                                Margin="5,0,9,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="GitLlama" />

                            <TextBlock DockPanel.Dock="Left"
                                       Text="GitLlama"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0" />

                            <Button x:Name="SettingsButton"
                                    DockPanel.Dock="Right"
                                    Classes="workspace toolbar"
                                    Width="36"
                                    Padding="7"
                                    AutomationProperties.Name="Settings"
                                    Click="Settings_Click"
                                    ToolTip.Tip="Settings">
                                <Path Width="20"
                                      Height="20"
                                      Stretch="Uniform"
                                      Data="M 10,2 L 14,2 L 15,5 L 17,6 L 20,5 L 22,9 L 20,11 L 20,13 L 22,15 L 20,19 L 17,18 L 15,19 L 14,22 L 10,22 L 9,19 L 7,18 L 4,19 L 2,15 L 4,13 L 4,11 L 2,9 L 4,5 L 7,6 L 9,5 Z M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 1 0 12,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" />
                            </Button>

                            <Menu DockPanel.Dock="Left"
                                  Background="Transparent"
                                  VerticalAlignment="Center">
                                <MenuItem Header="_File">
                                    <MenuItem Header="Open repository…"
                                              InputGesture="Ctrl+O"
                                              Click="OpenFolder_Click" />

                                    <MenuItem Header="Open repository by path…" Click="OpenPath_Click" />

                                    <MenuItem Header="Clone or initialize…"
                                              Click="ShowDocument_Click"
                                              Tag="Repository" />

                                    <Separator />

                                    <MenuItem Header="Toggle favorite"
                                              Command="{Binding ToggleFavoriteCommand}"
                                              IsEnabled="{Binding HasRepository}" />

                                    <MenuItem Header="Remove from recent repositories"
                                              Command="{Binding RemoveRepositoryCommand}"
                                              IsEnabled="{Binding HasRepository}" />

                                    <Separator />

                                    <MenuItem x:Name="FileSettingsMenuItem"
                                              Header="Settings…"
                                              Click="Settings_Click" />
                                </MenuItem>

                                <MenuItem Header="_View">
                                    <MenuItem Header="History"
                                              Click="ShowDocument_Click"
                                              Tag="History" />

                                    <MenuItem Header="Files"
                                              Click="ShowDocument_Click"
                                              Tag="Files" />

                                    <MenuItem Header="Pull Requests"
                                              Click="ShowDocument_Click"
                                              Tag="Pull Requests" />

                                    <MenuItem Header="Issues"
                                              Click="ShowDocument_Click"
                                              Tag="Issues" />

                                    <MenuItem Header="Working changes"
                                              Click="ShowDocument_Click"
                                              Tag="Changes" />

                                    <MenuItem Header="Merge and conflict resolution"
                                              Click="ShowDocument_Click"
                                              Tag="Branches" />

                                    <MenuItem Header="Remotes"
                                              Click="ShowDocument_Click"
                                              Tag="Remotes" />

                                    <MenuItem Header="Worktrees"
                                              Click="ShowDocument_Click"
                                              Tag="Worktrees" />

                                    <MenuItem Header="Reflog and recovery"
                                              Click="ShowDocument_Click"
                                              Tag="Reflog" />

                                    <MenuItem Header="Tags"
                                              Click="ShowDocument_Click"
                                              Tag="Tags" />

                                    <MenuItem Header="Stashes"
                                              Click="ShowDocument_Click"
                                              Tag="Stashes" />

                                    <MenuItem Header="Submodules"
                                              Click="ShowDocument_Click"
                                              Tag="Submodules" />

                                    <Separator />

                                    <MenuItem Header="Advanced history tools"
                                              Click="ShowDocument_Click"
                                              Tag="Advanced History" />

                                    <MenuItem Header="Working tree tools and stashes"
                                              Click="ShowDocument_Click"
                                              Tag="Working Tree Tools" />

                                    <MenuItem Header="Git identity"
                                              Click="ShowDocument_Click"
                                              Tag="Identity" />

                                    <MenuItem Header="Remote tag tools"
                                              Click="ShowDocument_Click"
                                              Tag="Remote Tools" />
                                </MenuItem>

                                <MenuItem Header="_Repository">
                                    <MenuItem Header="Refresh"
                                              InputGesture="F5"
                                              Command="{Binding RefreshCommand}" />

                                    <MenuItem Header="Git identity"
                                              Click="ShowDocument_Click"
                                              Tag="Identity" />
                                </MenuItem>

                                <MenuItem Header="_Branch">
                                    <MenuItem Header="Checkout selected branch" Command="{Binding CheckoutBranchCommand}" />

                                    <MenuItem Header="Merge and conflict resolution"
                                              Click="ShowDocument_Click"
                                              Tag="Branches" />
                                </MenuItem>

                                <MenuItem Header="_Commit">
                                    <MenuItem Header="Commit staged files"
                                              InputGesture="Ctrl+Enter"
                                              Command="{Binding CommitCommand}" />

                                    <MenuItem Header="Amend and stash tools"
                                              Click="ShowDocument_Click"
                                              Tag="Working Tree Tools" />
                                </MenuItem>

                                <MenuItem Header="_Remote">
                                    <MenuItem Header="Fetch" Command="{Binding FetchRemoteCommand}" />
                                    <MenuItem Header="Pull" Command="{Binding PullCommand}" />
                                    <MenuItem Header="Push" Command="{Binding PushRemoteCommand}" />

                                    <MenuItem Header="Manage remotes"
                                              Click="ShowDocument_Click"
                                              Tag="Remotes" />
                                </MenuItem>

                                <MenuItem Header="_Window">
                                    <MenuItem Header="Save current layout" Click="SaveLayout_Click" />
                                    <MenuItem Header="Restore saved layout" Click="LoadLayout_Click" />
                                    <MenuItem Header="Dock all documents" Click="DockDocuments_Click" />
                                    <MenuItem Header="Reset workspace" Click="ResetLayout_Click" />
                                    <Separator />
                                    <MenuItem Header="Close active document" Click="CloseTab_Click" />
                                </MenuItem>

                                <MenuItem Header="_Tools">
                                    <MenuItem Header="Command palette"
                                              InputGesture="Ctrl+Q"
                                              Click="CommandPalette_Click" />

                                    <MenuItem Header="Settings and diagnostics"
                                              Click="ShowDocument_Click"
                                              Tag="Settings" />
                                </MenuItem>
                            </Menu>
                        </DockPanel>
                    </Border>

                    <Border Background="#232428"
                            BorderBrush="#41434A"
                            BorderThickness="0,0,0,1"
                            Padding="8,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Height="36">
                                <ListBox x:Name="RepositoryTabs"
                                         Classes="repository-tabs"
                                         ItemsSource="{Binding RepositoryWorkspaceTabs}"
                                         SelectedItem="{Binding SelectedRepositoryWorkspaceTab, Mode=OneWay}"
                                         SelectionChanged="RepositoryTabs_SelectionChanged"
                                         Tapped="RepositoryTab_Tapped">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="12"
                                                  MinWidth="130"
                                                  MaxWidth="230">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Tooltip}" />

                                                <Button Grid.Column="1"
                                                        Classes="workspace toolbar"
                                                        Content="×"
                                                        Tag="{Binding}"
                                                        Click="CloseRepositoryTab_Click"
                                                        ToolTip.Tip="Close repository tab"
                                                        Padding="3,0"
                                                        MinHeight="24" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button x:Name="ManageRepositoriesButton"
                                        Classes="workspace toolbar"
                                        Content="＋"
                                        Click="ManageRepositories_Click"
                                        ToolTip.Tip="Manage repositories"
                                        Width="36" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border IsVisible="{Binding !IsRepositoryManagerSelected}"
                            Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                            <ItemsControl x:Name="RepositoryBreadcrumbBar"
                                          ItemsSource="{Binding RepositoryBreadcrumbs}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="›"
                                                       Classes="muted"
                                                       FontSize="18"
                                                       VerticalAlignment="Center"
                                                       Margin="2,8,2,0"
                                                       IsVisible="{Binding HasSeparator}" />

                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                                                <Button Classes="workspace toolbar"
                                                        Content="×"
                                                        Command="{Binding $parent[ItemsControl].DataContext.NavigateToRepositoryCommand}"
                                                        CommandParameter="{Binding Repository.Parent}"
                                                        IsVisible="{Binding IsSubmodule}"
                                                        ToolTip.Tip="Close submodule and return to its parent"
                                                        Padding="3,0"
                                                        MinHeight="0"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,4" />
                                                <Button Grid.Column="1"
                                                        Classes="workspace"
                                                        Classes.toolbar="{Binding !IsSubmodule}"
                                                        Classes.branch-picker="{Binding IsSubmodule}"
                                                        Click="RepositoryCrumb_Click"
                                                        ToolTip.Tip="{Binding Repository.Path}"
                                                        Padding="10,5">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Caption}" Classes="muted" FontSize="10" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="⌄" Classes="muted" IsVisible="{Binding IsSubmodule}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6">
                            <Button Classes="workspace branch-picker"
                                    Width="170"
                                    Click="BranchPicker_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{Binding HasRepository}"
                                    ToolTip.Tip="Switch local branch">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="branch"
                                               Classes="muted"
                                               FontSize="10" />

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="⑂" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentBranch}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2"
                                                   Text="⌄"
                                                   Classes="muted" />
                                    </Grid>
                                </StackPanel>
                            </Button>

                            <!-- Where the current branch pushes to and pulls from. -->
                            <Button x:Name="UpstreamPicker"
                                    Classes="workspace branch-picker"
                                    Width="190"
                                    Click="UpstreamPicker_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{Binding HasRepository}"
                                    ToolTip.Tip="{Binding UpstreamDetail}">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="push / pull"
                                               Classes="muted"
                                               FontSize="10" />

                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="⇅" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpstreamCaption}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UpstreamCounts}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3"
                                                   Text="⌄"
                                                   Classes="muted" />
                                    </Grid>
                                </StackPanel>
                            </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding HasRepository}">
                                <Button x:Name="FetchButton"
                                        Classes="workspace repository-action"
                                        Content="↓  Fetch"
                                        Command="{Binding FetchUpstreamCommand}"
                                        ToolTip.Tip="{Binding FetchToolTip}" />

                                <Grid ColumnDefinitions="*,20">
                                <Button x:Name="PullButton"
                                        Classes="workspace repository-action"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Content="↓  Pull"
                                        Command="{Binding PullCommand}"
                                        ContextRequested="PullOptions_ContextRequested"
                                        ToolTip.Tip="{Binding PullToolTip}" />
                                    <controls:PullOptionsButton Grid.Column="1" />
                                    <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                                        <Border Classes="sync-count" Canvas.Right="-4" Canvas.Top="-6" IsVisible="{Binding HasPullCommits}">
                                            <TextBlock Text="{Binding PullCommitCount}" />
                                        </Border>
                                    </Canvas>
                                </Grid>

                                <Grid>
                                <Button x:Name="PushButton"
                                        Classes="workspace repository-action"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Content="↑  Push"
                                        Command="{Binding PushToUpstreamCommand}"
                                        ToolTip.Tip="{Binding PushToolTip}" />
                                    <Canvas IsHitTestVisible="False">
                                        <Border Classes="sync-count" Canvas.Right="-4" Canvas.Top="-6" IsVisible="{Binding HasPushCommits}">
                                            <TextBlock Text="{Binding PushCommitCount}" />
                                        </Border>
                                    </Canvas>
                                </Grid>

                                <Button x:Name="RefreshButton"
                                        Classes="workspace repository-action"
                                        Content="↻  Refresh"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip.Tip="Refresh repository (F5)" />

                                <Button Classes="workspace toolbar"
                                        Content="Cancel"
                                        Command="{Binding CancelNetworkCommand}"
                                        IsVisible="{Binding IsNetworkBusy}" />
                            </StackPanel>

                            <Button x:Name="WorkingChangesButton"
                                    Grid.Column="3"
                                    Classes="workspace repository-action"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ViewChanges_Click"
                                    IsEnabled="{Binding HasRepository}"
                                    ToolTip.Tip="Review and commit working changes">
                                <TextBlock Text="{Binding WorkingChangesCaption}" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="RepositoryOpenErrorBanner"
                            IsVisible="{Binding HasRepositoryOpenError}"
                            Background="#3B2F32" BorderBrush="#72505A" BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding RepositoryOpenError}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="workspace toolbar" Content="✕"
                                    Command="{Binding DismissRepositoryOpenErrorCommand}"
                                    ToolTip.Tip="Dismiss repository error" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border x:Name="RemoteFeedbackBanner"
                            IsVisible="{Binding HasRemoteOperationFeedback}"
                            Background="#2B3B50"
                            BorderBrush="#7F9FC9"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding RemoteOperationFeedback}" TextWrapping="Wrap" />

                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <Button Classes="workspace primary"
                                            Content="Reconnect GitHub for workflow access…"
                                            Command="{Binding ReconnectGithubPermissionsCommand}"
                                            IsVisible="{Binding NeedsGithubWorkflowAccess}"
                                            IsEnabled="{Binding !IsAuthenticationBusy}" />

                                    <Button x:Name="GithubGrantAccessButton"
                                            Classes="workspace"
                                            Content="Manage GitLlama access…"
                                            Command="{Binding ManageGithubPushAccessCommand}"
                                            IsVisible="{Binding HasGithubPushAccessLink}"
                                            IsEnabled="{Binding !IsAuthenticationBusy}" />

                                    <Button Classes="workspace primary"
                                            Content="Enable private repository access…"
                                            Command="{Binding EnableGithubPrivateAccessCommand}"
                                            IsVisible="{Binding NeedsGithubPrivateAccess}"
                                            IsEnabled="{Binding !IsAuthenticationBusy}" />
                                </WrapPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="workspace toolbar"
                                    Content="×"
                                    Command="{Binding DismissRemoteFeedbackCommand}"
                                    ToolTip.Tip="Dismiss operation feedback"
                                    AutomationProperties.Name="Dismiss operation feedback" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource ToolbarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Spacing="14"
                                    Margin="18,0,0,0">
                            <TextBlock Text="{Binding UpstreamStatus}"
                                       Classes="muted"
                                       IsVisible="{Binding HasRepository}" />

                            <TextBlock Text="{Binding CurrentBranch}" Classes="muted" />
                            <TextBlock Text="{Binding SelectedRepository.Name}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Grid>
                    <dock:DockControl x:Name="WorkspaceDock"
                                      Margin="8,6,8,0"
                                      IsVisible="{Binding !IsRepositoryManagerSelected}" />

                    <views:RepositoryView x:Name="RepositoryManager"
                                          Margin="8,6,8,0"
                                          IsVisible="{Binding IsRepositoryManagerSelected}" />
                </Grid>
            </DockPanel>

            <views:BranchSwitchView x:Name="BranchSwitchOverlay"
                                    IsVisible="{Binding IsLoading}" />

            <Grid x:Name="SettingsOverlay"
                  IsVisible="{Binding IsSettingsOpen}"
                  Background="#B3000000"
                  ColumnDefinitions="*,14*,*"
                  RowDefinitions="*,14*,*"
                  KeyboardNavigation.TabNavigation="Cycle">
                <Border Grid.Column="1"
                        Grid.Row="1"
                        Background="#292C32"
                        BorderBrush="#4B5360"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <views:SettingsView />
                </Border>
            </Grid>

            <Grid x:Name="ResizeHandles">
                <Border Height="6"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Cursor="SizeNorthSouth"
                        Tag="North"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Height="6"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="SizeNorthSouth"
                        Tag="South"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Width="6"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Cursor="SizeWestEast"
                        Tag="West"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Width="6"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Cursor="SizeWestEast"
                        Tag="East"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Cursor="TopLeftCorner"
                        Tag="NorthWest"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Cursor="TopRightCorner"
                        Tag="NorthEast"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="BottomLeftCorner"
                        Tag="SouthWest"
                        PointerPressed="WindowEdge_PointerPressed" />

                <Border Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="BottomRightCorner"
                        Tag="SouthEast"
                        PointerPressed="WindowEdge_PointerPressed" />
            </Grid>

            <Border x:Name="SshPromptBackdrop"
                    Background="#99000000"
                    IsVisible="False" />
            <views:ErrorNotificationsView x:Name="ErrorNotifications" />
        </Grid>
    </Border>
</Window>
