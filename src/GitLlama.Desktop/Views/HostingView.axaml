<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitLlama.Desktop.Views.HostingView">
    <Grid Margin="10"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="8">
        <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="8">
            <StackPanel Spacing="3">
                <TextBlock Text="Pull requests" FontSize="18" FontWeight="SemiBold" IsVisible="{Binding IsPullRequestWorkspace}" />
                <TextBlock Text="All GitHub remotes in this repository" Classes="muted" IsVisible="{Binding IsPullRequestWorkspace}" />
                <TextBlock Text="Issues" FontSize="18" FontWeight="SemiBold" IsVisible="{Binding !IsPullRequestWorkspace}" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding HostingStates}"
                      SelectedItem="{Binding HostingState}" />

            <Button x:Name="RefreshItems"
                    Grid.Column="2"
                    Classes="workspace"
                    Content="Refresh"
                    IsEnabled="{Binding !IsHostingBusy}" />
        </Grid>

        <Border Grid.Row="1" Classes="card">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="workspace toolbar" Content="Manage integrations"
                        Command="{Binding OpenSettingsSectionCommand}" CommandParameter="Integrations" />
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding GithubAccountStatus}" />
                    <TextBlock Text="Connect GitHub in Integrations for private repositories and reviews."
                               Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,4,*">
            <Grid RowDefinitions="*,Auto">
                <ListBox x:Name="HostingItems">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" Margin="4,5">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="MoreItems"
                        Grid.Row="1"
                        Classes="workspace"
                        Content="Retry incomplete list" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#3F3F46" />

            <ScrollViewer Grid.Column="2" Margin="10,0,0,0">
                <StackPanel Spacing="12">
                    <SelectableTextBlock Text="{Binding HostingDetails}" TextWrapping="Wrap" />

                    <Button Classes="workspace"
                            Content="Open selected on GitHub"
                            Click="OpenItem_Click" />

                    <ItemsControl ItemsSource="{Binding HostingComments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Margin="0,0,0,8">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                                        <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Text="{Binding HostingComment}"
                             Watermark="Comment or review message"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90" />

                    <Button Classes="workspace"
                            Content="Post comment"
                            Command="{Binding PostHostingCommentCommand}"
                            IsEnabled="{Binding !IsHostingBusy}" />

                    <WrapPanel IsVisible="{Binding IsPullRequestWorkspace}"
                               ItemSpacing="8"
                               LineSpacing="8">
                        <Button Classes="workspace"
                                Content="Approve"
                                Command="{Binding ApprovePullRequestCommand}" />

                        <Button Classes="workspace"
                                Content="Request changes"
                                Command="{Binding RequestPullRequestChangesCommand}" />
                    </WrapPanel>

                    <Expander Header="Merge pull request on GitHub" IsVisible="{Binding IsPullRequestWorkspace}">
                        <StackPanel Spacing="8" Margin="8">
                            <TextBlock Text="GitHub checks the loaded head commit and repository merge rules before merging."
                                       Classes="muted"
                                       TextWrapping="Wrap" />

                            <Button Classes="workspace"
                                    Content="Merge on GitHub"
                                    Command="{Binding MergePullRequestCommand}" />
                        </StackPanel>
                    </Expander>

                    <Button Classes="workspace"
                            Content="Close / reopen selected issue"
                            Command="{Binding ToggleIssueStateCommand}"
                            IsVisible="{Binding !IsPullRequestWorkspace}" />

                    <Expander Header="Create new item">
                        <StackPanel Spacing="8" Margin="8">
                            <TextBlock Text="Destination for the new item" Classes="muted" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Watermark="GitHub owner" Text="{Binding GithubOwner}" />
                                <TextBox Grid.Column="1" Watermark="Repository" Text="{Binding GithubRepository}" />
                            </Grid>
                            <TextBox Text="{Binding HostingDraftTitle}" Watermark="Title" />

                            <TextBox Text="{Binding HostingDraftBody}"
                                     Watermark="Description"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     TextWrapping="Wrap" />

                            <TextBox Text="{Binding PullRequestHead}"
                                     Watermark="Head branch (push it first)"
                                     IsVisible="{Binding IsPullRequestWorkspace}" />

                            <TextBox Text="{Binding PullRequestBase}"
                                     Watermark="Base branch"
                                     IsVisible="{Binding IsPullRequestWorkspace}" />

                            <Button x:Name="CreateItem"
                                    Classes="workspace"
                                    Content="Create"
                                    IsEnabled="{Binding !IsHostingBusy}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding HostingStatus}"
                   Classes="muted"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
