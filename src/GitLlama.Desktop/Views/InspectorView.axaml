<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitLlama.Desktop.Views.InspectorView">
    <UserControl.Styles>
        <Style Selector="ListBox.commit-files">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.commit-files ListBoxItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Expander.change-group">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style Selector="Expander.change-group.empty">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Expander.change-group.empty /template/ ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Expander.change-group /template/ ToggleButton">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Border.file-status">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.file-status TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <Border Background="{StaticResource InspectorBrush}"
            BorderBrush="#393E47"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <ScrollViewer AllowAutoHide="False"
                          IsVisible="{Binding !IsWorkingTreeInspector}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" Spacing="14">
                    <TextBlock Text="{Binding HistorySubject}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <Border Classes="card" IsVisible="{Binding HasHistoryMessage}">
                        <SelectableTextBlock Text="{Binding HistoryMessage}" TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                        <Border Background="{Binding HistoryAvatar.Background, FallbackValue=#41434A}"
                                CornerRadius="18"
                                Width="36"
                                Height="36"
                                ClipToBounds="True"
                                VerticalAlignment="Top">
                            <Panel>
                                <TextBlock Text="{Binding HistoryAvatar.Initials, FallbackValue=●}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <Image Source="{Binding HistoryAvatar.Image}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding HistoryAuthor}" />

                            <TextBlock Text="{Binding HistoryDate}"
                                       FontSize="11"
                                       Classes="muted" />

                            <SelectableTextBlock Text="{Binding HistorySha}"
                                                 FontSize="11"
                                                 Classes="muted" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Changed files" Classes="section" />

                    <ListBox x:Name="CommitFileList" Classes="file-list" SelectionMode="Multiple"
                             ItemsSource="{Binding HistoryFileRows}"
                             SelectedItems="{Binding SelectedCommitFiles}"
                             SelectionChanged="CommitFile_SelectionChanged"
                             MaxHeight="300" />

                    <Expander Classes="navigation" Header="Commit metadata">
                        <SelectableTextBlock Text="{Binding HistoryCommitDetails}"
                                             TextWrapping="Wrap"
                                             Margin="0,8" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid IsVisible="{Binding IsWorkingTreeInspector}" RowDefinitions="Auto,*,Auto">
                <Border BorderBrush="#393E47"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="#404249"
                                    CornerRadius="5"
                                    Padding="8,3">
                                <TextBlock Text="{Binding ChangeCount}" Foreground="#DBDEE1" />
                            </Border>

                            <TextBlock Text="{Binding WorkingInspectorTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Text="{Binding StagingSummary}" Classes="muted" />

                        <Border IsVisible="{Binding ShowMergeBanner}"
                                Background="#3B2B2B"
                                BorderBrush="#F48771"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding MergeBannerText}" TextWrapping="Wrap" />

                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <Button Classes="workspace toolbar"
                                            Content="Resolve conflicts"
                                            Command="{Binding OpenConflictResolutionCommand}"
                                            IsVisible="{Binding HasMergeConflicts}" />

                                    <Button Classes="workspace toolbar"
                                            Content="Finish merge"
                                            Command="{Binding ContinueMergeCommand}"
                                            IsVisible="{Binding CanFinishMerge}" />

                                    <Button Classes="workspace toolbar"
                                            Content="Abort merge"
                                            Click="AbortMerge_Click"
                                            IsVisible="{Binding IsMergeInProgress}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel ItemSpacing="8" IsVisible="{Binding IsCommitInspector}" IsEnabled="{Binding !IsFeatureBusy}">
                            <Button Classes="workspace toolbar"
                                    Content="{Binding InspectorStageLabel}"
                                    IsEnabled="{Binding CanInspectorStage}"
                                    Command="{Binding StageInspectorFilesCommand}" />

                            <Button Classes="workspace toolbar"
                                    Content="{Binding InspectorUnstageLabel}"
                                    IsEnabled="{Binding CanInspectorUnstage}"
                                    Command="{Binding UnstageInspectorFilesCommand}" />
                            <Button Content="Clear selection" Classes="workspace toolbar"
                                    Command="{Binding ClearInspectorFileSelectionCommand}"
                                    IsVisible="{Binding HasWorkingFileSelection}" />

                            <Button x:Name="DiscardAllChangesButton"
                                    Classes="workspace toolbar"
                                    Content="{Binding InspectorDiscardLabel}"
                                    Foreground="#F28B93"
                                    IsVisible="{Binding CanDiscardAllChanges}"
                                    IsEnabled="{Binding !IsFeatureBusy}"
                                    Click="DiscardAll_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer AllowAutoHide="False"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,4" Spacing="4">
                        <TextBlock Text="Everything is up to date."
                                   IsVisible="{Binding HasNoChanges}"
                                   Classes="muted"
                                   Margin="8,10" />

                        <Expander Classes="navigation"
                                  IsExpanded="True"
                                  IsVisible="{Binding IsConflictInspector}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ConflictedFilesCaption}" VerticalAlignment="Center" />

                                    <Button x:Name="MarkAllResolvedButton"
                                            Grid.Column="1"
                                            Classes="workspace toolbar"
                                            Content="Mark all resolved"
                                            Command="{Binding MarkAllConflictsResolvedCommand}"
                                            IsVisible="{Binding HasMergeConflicts}"
                                            ToolTip.Tip="Mark files you've fixed yourself as resolved. Files that still contain conflict markers stay conflicted."
                                            Padding="8,2"
                                            MinHeight="0" />
                                </Grid>
                            </Expander.Header>

                            <StackPanel>
                                <ListBox x:Name="ConflictedFileList"
                                         Classes="file-list"
                                         ItemsSource="{Binding ConflictedFiles}"
                                         SelectedItem="{Binding SelectedConflictFile, Mode=OneWay}"
                                         SelectionChanged="ConflictedFile_SelectionChanged"
                                         Tapped="ConflictedFile_Tapped"
                                         ContextRequested="ConflictedFileContextRequested"
                                         MaxHeight="300">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="22,*"
                                                  ColumnSpacing="4"
                                                  ToolTip.Tip="{Binding Path}">
                                                <TextBlock Text="⚠"
                                                           Foreground="#E5C07B"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Folder}" Foreground="#80848E" />
                                                    <Run Text="{Binding FileName}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="No conflicts left. Finish the merge to commit it."
                                           Classes="muted"
                                           Margin="8,4"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !HasMergeConflicts}" />
                            </StackPanel>
                        </Expander>

                        <Border BorderBrush="#393E47"
                                BorderThickness="0,1,0,0"
                                IsVisible="{Binding IsConflictInspector}" />

                        <Expander Classes="navigation"
                                  Header="{Binding ResolvedFilesCaption}"
                                  IsExpanded="True"
                                  IsVisible="{Binding IsConflictInspector}">
                            <ListBox x:Name="ResolvedFileList"
                                     Classes="file-list"
                                     ItemsSource="{Binding ResolvedFiles}"
                                     SelectionChanged="ResolvedFile_SelectionChanged"
                                     MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="22,*"
                                              ColumnSpacing="4"
                                              ToolTip.Tip="{Binding Path}">
                                            <TextBlock Text="✓"
                                                       Foreground="#7F9FC9"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Folder}" Foreground="#80848E" />
                                                <Run Text="{Binding FileName}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander Classes="navigation change-group"
                                  Classes.empty="{Binding !HasStagedFiles}"
                                  Header="{Binding StagedFilesCaption}"
                                  IsVisible="{Binding IsCommitInspector}">
                            <ListBox x:Name="StagedFileList" Classes="file-list commit-files" SelectionMode="Multiple"
                                     IsVisible="{Binding HasStagedFiles}"
                                     ItemsSource="{Binding StagedFiles}"
                                     SelectedItems="{Binding SelectedStagedFiles}"
                                     SelectionChanged="StagedFile_SelectionChanged"
                                     ContextRequested="WorkingFileContextRequested"
                                     MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="22,24,*,Auto,Auto" ColumnSpacing="4">
                                            <CheckBox IsChecked="True"
                                                      Tag="unstage"
                                                      Click="StageCheckbox_Click"
                                                      ToolTip.Tip="Unstage this file"
                                                      MinWidth="0" Padding="0"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    Background="#454750"
                                                    CornerRadius="4"
                                                    Padding="3"
                                                    Width="22"
                                                    Height="22">
                                                <TextBlock Text="{Binding FileIcon}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Path}" />

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                            <Border Background="#2B3B50"
                                                    BorderBrush="#7F9FC9"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLfs}"
                                                    ToolTip.Tip="Stored in Git LFS">
                                                <TextBlock Text="LFS" FontSize="9" />
                                            </Border>

                                            <Path Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7 M 1.5,7 L 10.5,7 L 10.5,13 L 1.5,13 Z"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding LockColor}"
                                                  StrokeThickness="1.3"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding HasLock}"
                                                  ToolTip.Tip="{Binding LockToolTip}" />
                                            </StackPanel>

                                            <Border Grid.Column="3" Classes="file-status"
                                                    Background="{Binding StagedStatusBackground}">
                                                <TextBlock Text="{Binding StagedStatus}" Foreground="{Binding StagedStatusColor}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Border BorderBrush="#393E47"
                                BorderThickness="0,1,0,0"
                                IsVisible="{Binding IsCommitInspector}" />

                        <Expander Classes="navigation change-group"
                                  Classes.empty="{Binding !HasUnstagedFiles}"
                                  Header="{Binding UnstagedFilesCaption}"
                                  IsVisible="{Binding IsCommitInspector}">
                            <ListBox x:Name="UnstagedFileList" Classes="file-list commit-files" SelectionMode="Multiple"
                                     IsVisible="{Binding HasUnstagedFiles}"
                                     ItemsSource="{Binding UnstagedFiles}"
                                     SelectedItems="{Binding SelectedUnstagedFiles}"
                                     SelectionChanged="UnstagedFile_SelectionChanged"
                                     ContextRequested="WorkingFileContextRequested"
                                     MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="22,24,*,Auto,Auto" ColumnSpacing="4">
                                            <CheckBox IsChecked="False"
                                                      Tag="stage"
                                                      Click="StageCheckbox_Click"
                                                      ToolTip.Tip="Stage this file"
                                                      MinWidth="0" Padding="0"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    Background="#383A40"
                                                    CornerRadius="4"
                                                    Padding="3"
                                                    Width="22"
                                                    Height="22">
                                                <TextBlock Text="{Binding FileIcon}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Path}" />

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                            <Border Background="#2B3B50"
                                                    BorderBrush="#7F9FC9"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLfs}"
                                                    ToolTip.Tip="Stored in Git LFS">
                                                <TextBlock Text="LFS" FontSize="9" />
                                            </Border>

                                            <Path Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7 M 1.5,7 L 10.5,7 L 10.5,13 L 1.5,13 Z"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding LockColor}"
                                                  StrokeThickness="1.3"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding HasLock}"
                                                  ToolTip.Tip="{Binding LockToolTip}" />
                                            </StackPanel>

                                            <Border Grid.Column="3" Classes="file-status"
                                                    Background="{Binding UnstagedStatusBackground}">
                                                <TextBlock Text="{Binding UnstagedStatus}" Foreground="{Binding UnstagedStatusColor}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander Classes="navigation"
                                  Header="Selected file actions"
                                  IsVisible="{Binding HasSelectedWorkingFile}">
                            <StackPanel Margin="8" Spacing="8">
                                <Button Classes="workspace"
                                        Content="Export patch…"
                                        Click="ExportPatch_Click"
                                        HorizontalAlignment="Left" />

                                <TextBlock Text="Discard restores staged content and loses unstaged edits."
                                           Classes="muted"
                                           TextWrapping="Wrap" />

                                <Button Classes="workspace"
                                        Content="Discard unstaged edits"
                                        Command="{Binding DiscardSelectedUnstagedCommand}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#313338"
                        BorderBrush="#393E47"
                        BorderThickness="0,1,0,0"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <StackPanel.Styles>
                            <Style Selector="RadioButton.mode-tab">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#B5BAC1" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="12,5">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>

                            <Style Selector="RadioButton.mode-tab:pointerover">
                                <Setter Property="Background" Value="#383A40" />
                                <Setter Property="Foreground" Value="#DBDEE1" />
                            </Style>

                            <Style Selector="RadioButton.mode-tab:checked">
                                <Setter Property="Background" Value="#4E5058" />
                                <Setter Property="Foreground" Value="#F2F3F5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Styles>

                        <Border Background="#1E1F22"
                                CornerRadius="6"
                                Padding="3">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="CommitModeTab"
                                             Classes="mode-tab"
                                             Content="Commit"
                                             IsChecked="{Binding !IsStashMode, Mode=OneWay}" />

                                <RadioButton x:Name="StashModeTab"
                                             Classes="mode-tab"
                                             Content="Stash"
                                             IsChecked="{Binding IsStashMode}" />
                            </UniformGrid>
                        </Border>

                        <StackPanel Spacing="9" IsVisible="{Binding !IsStashMode}">
                            <TextBox Text="{Binding CommitSummaryText}" Watermark="Commit summary" />

                            <TextBox Text="{Binding CommitDescriptionText}"
                                     Watermark="Description (optional)"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="64" />

                            <CheckBox Content="Amend latest unpublished commit" IsChecked="{Binding AmendStagedCommit}" />
                            <TextBlock Text="Leave the message blank to keep the current commit message."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding AmendStagedCommit}" />
                        </StackPanel>

                        <StackPanel Spacing="9" IsVisible="{Binding IsStashMode}">
                            <TextBox Text="{Binding StashMessage}" Watermark="Stash message (optional)" />

                            <TextBlock Text="Sets aside your staged changes. Unstaged edits and untracked files stay in the working tree; stage them to include them."
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Content="{Binding CommitButtonText}"
                                Command="{Binding CommitCommand}"
                                IsVisible="{Binding !IsStashMode}"
                                Classes="workspace primary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinHeight="40" />

                        <Button Content="Stash staged changes"
                                Command="{Binding SaveStagedStashCommand}"
                                IsVisible="{Binding IsStashMode}"
                                ToolTip.Tip="{Binding StashBlockedReason}"
                                ToolTip.ShowOnDisabled="True"
                                Classes="workspace primary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinHeight="40" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
