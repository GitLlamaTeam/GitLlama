<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GitLlama.Desktop.Views"
             xmlns:controls="clr-namespace:GitLlama.Desktop.Controls"
             x:Class="GitLlama.Desktop.Views.RemotesView">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="Remotes"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="AddRemoteButton"
                        Classes="workspace primary"
                        Content="Add remote…"
                        Click="AddRemote_Click" />

                <Button Classes="workspace"
                        Content="Edit URL…"
                        Click="EditRemote_Click" />

                <Button Classes="workspace"
                        Content="Remove remote…"
                        Click="RemoveRemote_Click" />
            </WrapPanel>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <views:RemoteTreeView MaxHeight="320" />

                    <TextBlock Text="Right-click a remote to edit its URL, remove it, or create a branch. Right-click a branch to rename or delete it on the server. Double-click to check out a local tracking branch."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding SelectedRemote.Name}" FontWeight="SemiBold" />

            <TextBlock Text="{Binding SelectedRemote.Url}"
                       Classes="muted"
                       TextWrapping="Wrap" />

            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="workspace"
                        Content="Fetch"
                        Command="{Binding FetchRemoteCommand}" />

                <Button Classes="workspace"
                        Content="Pull"
                        Command="{Binding PullCommand}" />
                <controls:PullOptionsButton />

                <Button Classes="workspace"
                        Content="Push current branch"
                        Command="{Binding PushRemoteCommand}" />

                <Button Classes="workspace"
                        Content="Cancel operation"
                        Command="{Binding CancelNetworkCommand}"
                        IsVisible="{Binding IsNetworkBusy}" />
            </WrapPanel>

            <TextBlock Text="{Binding NetworkProgressText}" Classes="muted" />

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Connection settings" Classes="section" />
                    <TextBlock Text="{Binding NetworkCredentialHost}" Classes="muted" />

                    <TextBlock Text="Manage accounts, HTTPS credentials and SSH keys in Settings."
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <Button Classes="workspace"
                            Content="Open authentication settings"
                            Click="AuthenticationSettings_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Branch tracking" Classes="section" />
                    <TextBox Text="{Binding UpstreamBranchName}" Watermark="Remote branch to track (for example main)" />

                    <WrapPanel ItemSpacing="8">
                        <Button Classes="workspace"
                                Content="Set upstream"
                                Command="{Binding SetUpstreamCommand}" />

                        <Button Classes="workspace"
                                Content="Clear upstream"
                                Command="{Binding ClearUpstreamCommand}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding UpstreamStatus}" Classes="muted" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
